                            location: newsItem.address,
                            rating: "⭐⭐⭐⭐☆",
                            latitude: newsItem.latitude,
                            longitude: newsItem.longitude,
                            name: newsItem.store_name,
                            facilities: Object.entries({
                                allows_pets: newsItem.allows_pets,
                                has_wifi: newsItem.has_wifi,
                                allows_reservations: newsItem.allows_reservations,
                                wheelchair_accessible: newsItem.wheelchair_accessible,
                                has_disabled_parking: newsItem.has_disabled_parking,
                                has_wheelchair_ramp: newsItem.has_wheelchair_ramp,
                                wide_doorways: newsItem.wide_doorways,
                                provides_home_service: newsItem.provides_home_service,
                                blind_assistance: newsItem.blind_assistance,
                                deaf_support: newsItem.deaf_support,
                                quiet_service_space: newsItem.quiet_service_space,
                                dementia_care: newsItem.dementia_care,
                                intellectual_disability_support: newsItem.intellectual_disability_support,
                                safety_restraint_chairs: newsItem.safety_restraint_chairs,
