        async function saveShop() {
            const nameInput = document.getElementById("shop-name");
            const addressInput = document.getElementById("shop-address");
            const descriptionInput = document.getElementById("shop-description");

            const name = nameInput.value.trim();
            const address = addressInput.value.trim();
            const description = descriptionInput.value.trim();

            if (!name || !address || !description) {
                alert("모든 필드를 채워주세요!");
                return;
            }

            // 매장 데이터 저장 또는 수정
            shopData = { name, address, description };
            const formData = new FormData(); // FormData 객체 생성
            const fileInput = document.getElementById('storeMainImage2'); // 파일 입력 필드 가져오기

            // 파일이 선택되었는지 확인하고 FormData에 추가
            if (fileInput.files.length > 0) {
                formData.append('storeMainImage', fileInput.files[0]); // 파일 추가
            }

            // fetch를 사용해 서버로 POST 요청 보내기
            try {
                const response = await fetch('/storeSettingsUpdate', {
                    method: 'POST',
                    body: formData // FormData 객체를 요청 본문으로 사용
                });

                // 서버로부터의 응답 처리
                const result = await response.json();


                // 사용자가 확인을 클릭한 경우
                const reqs = {
                    query_input: [],
                    username: id,
                    requestid: 55,
                    query: `
        UPDATE users
        SET 
            photo_url = '/uploads/${result.data.storeMainImage}',
            store_name = '${name}',
            shop = true,
            address = '${address}',
            introduction = '${description}'
        WHERE id = ${id};
    `
                };

                // 서버로 데이터 전송
                fetch('serviceadd', { // 서버의 리뷰 저장 라우트에 맞게 수정
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    credentials: 'include',
                    body: JSON.stringify(reqs),
                })
                    .then(response => response.json())
                    .then(result => {
                        console.log(result);
                        if (result.message == 'Success') {
                            alert('수정되었습니다.');
                            // 페이지를 갱신하거나 다른 동작 수행


                        } else {
                            alert('수정에 실패했습니다.');
                        }
                    })
                    .catch(error => {
                        console.error('에러 발생:', error);
                        alert('수정에 실패했습니다.');
                    });

            }
            catch (error) {
                console.error('오류 발생:', error);
            }
            // 모달 닫기
            closeShopModal();

            // 매장 리스트 렌더링
            renderShopList();
        }
