        // 달력 생성 함수
        function createCalendar(year, month) {
            const calendar = document.getElementById('calendar');
            calendar.innerHTML = '';

            const header = document.createElement('div');
            header.className = 'calendar-header';

            // 이전 버튼 생성
            const prevButton = document.createElement('button');
            prevButton.textContent = '<';
            prevButton.addEventListener('click', () => {
                month--;
                if (month < 0) {
                    month = 11;
                    year--;
                }
                createCalendar(year, month);
            });

            // 다음 버튼 생성
            const nextButton = document.createElement('button');
            nextButton.textContent = '>';
            nextButton.addEventListener('click', () => {
                month++;
                if (month > 11) {
                    month = 0;
                    year++;
                }
                createCalendar(year, month);
            });

            const title = document.createElement('h3');
            title.textContent = `${year}년 ${month + 1}월`;

            header.appendChild(prevButton);
            header.appendChild(title);
            header.appendChild(nextButton);

            const weekDays = ['일', '월', '화', '수', '목', '금', '토'];
            const daysHeader = document.createElement('div');
            daysHeader.className = 'calendar-body';

            weekDays.forEach((day, index) => {
                const dayElement = document.createElement('div');
                dayElement.className = 'day weekday-header';
                dayElement.textContent = day;
                daysHeader.appendChild(dayElement);
            });

            const body = document.createElement('div');
            body.className = 'calendar-body';

            const firstDay = new Date(year, month, 1).getDay();
            const lastDate = new Date(year, month + 1, 0).getDate();
            const today = new Date();

            // 빈 칸 채우기
            for (let i = 0; i < firstDay; i++) {
                const emptyCell = document.createElement('div');
                emptyCell.className = 'day empty';
                body.appendChild(emptyCell);
            }

            // 날짜 채우기
            for (let date = 1; date <= lastDate; date++) {
                const dateCell = document.createElement('div');
                dateCell.className = 'day';
                dateCell.textContent = date;

                const fullDate = new Date(year, month, date);
                const dateKey = fullDate.toISOString().split('T')[0];

                // 오늘 날짜 표시
                if (
                    date === today.getDate() &&
                    month === today.getMonth() &&
                    year === today.getFullYear()
                ) {
                    dateCell.classList.add('today');
                }

                // 과거 날짜는 비활성화
                if (fullDate < today) {
                    dateCell.classList.add('disabled');
                    dateCell.style.pointerEvents = 'none';
                }

                // 날짜 선택 시 시간 슬롯 표시
                dateCell.addEventListener('click', () => {
                    // 기존 선택된 날짜 해제
                    const previouslySelectedDate = document.querySelector('.selected-date');
                    if (previouslySelectedDate) {
                        previouslySelectedDate.classList.remove('selected-date');
                    }
                    // 선택된 날짜 초록색 표시
                    dateCell.classList.add('selected-date');
                    selectedDateStr = `${year}-${String(month + 1).padStart(2, '0')}-${String(date).padStart(2, '0')}`;


                    const reqs = {
                        query: `
                   SELECT sr.reservation_date, s.needtime, sr.start_time
                    FROM ServiceRequests AS sr
                    JOIN service AS s ON sr.service_id = s.id
                    WHERE sr.reservation_date = '${selectedDateStr}'
                    AND sr.status = 'pending'
                      AND sr.designer_id = '${selectedService.designer_id}';

                `,
                        query_input: [],
                        requestid: 5,
                    };

                    fetch('ServiceRequest', { // 특정 서비스의 위도/경도 가져오기
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                        },
                        credentials: 'include',
                        body: JSON.stringify(reqs),
                    })
                        .then(response => response.json())
                        .then(result => {
                            reservations = [];
                            console.log(result.data);
                            result.data.forEach(item => {

                                let reservationDate = item.reservation_date;  // '2024-10-14T15:00:00.000Z'

                                // 날짜를 Date 객체로 변환
                                let dateObj = new Date(reservationDate);

                                // 1일 추가
                                dateObj.setDate(dateObj.getDate() + 1);

                                // 날짜를 다시 'YYYY-MM-DD' 형식의 문자열로 변환
                                const dateOnly = dateObj.toISOString().split('T')[0];  // '2024-10-15'

                                reservationDate = dateOnly;

                                console.log(reservationDate);  // 1일 추가된 날짜 출력

                                const startTime = item.start_time; // 시작 시간
                                const designerName = item.designer_name; // 디자이너 이름

                                // 날짜가 이미 reservations 객체에 존재하는지 확인
                                if (reservations[reservationDate]) {
                                    // 날짜가 존재하면 배열에 새로운 시간 및 디자이너 정보 추가
                                    reservations[reservationDate].push(
                                        startTime

                                    );
                                } else {
                                    // 날짜가 없으면 새로운 배열 생성 후 추가
                                    reservations[reservationDate] = [
                                        startTime

                                    ];
                                }
                            });
                            console.log(reservations); createTimeSlots(selectedDateStr);

                        })
                        .catch(error => {
                            console.error('에러 발생:', error);
                        });
                    document.getElementById('confirm-reservation').style.display = 'none'; // 시간 선택 시 예약 버튼 숨기기
                });

                body.appendChild(dateCell);
            }


            calendar.appendChild(header);
            calendar.appendChild(daysHeader);
            calendar.appendChild(body);
        }

