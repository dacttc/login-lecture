        function renderSalons() {
            // 기존 내용 초기화
            salonListElement.innerHTML = '';

            // 배열이 비었을 경우 메시지 카드 추가
            if (salons.length == 0) {
                const noSalonElement = document.createElement('div');
                noSalonElement.classList.add('no-salons');
                noSalonElement.innerHTML = `
            <div class="message-card">
                <h3>조건에 맞는 미용실이 없습니다</h3>
                <p>다른 조건으로 검색해보세요!</p>
            </div>
        `;
                salonListElement.appendChild(noSalonElement);
                return; // 아래 코드 실행 방지
            }

            // 지도 중심 좌표 가져오기
            const centers = map.getCenter();
            const centerLat = centers.getLat();
            const centerLng = centers.getLng();

            // 거리를 계산하는 함수 (하버사인 공식을 사용)
            function calculateDistance(lat1, lng1, lat2, lng2) {
                const R = 6371; // 지구 반지름 (km)
                const toRad = (value) => (value * Math.PI) / 180;

                const dLat = toRad(lat2 - lat1);
                const dLng = toRad(lng2 - lng1);

                const a =
                    Math.sin(dLat / 2) * Math.sin(dLat / 2) +
                    Math.cos(toRad(lat1)) *
                    Math.cos(toRad(lat2)) *
                    Math.sin(dLng / 2) *
                    Math.sin(dLng / 2);

                const c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
                return R * c; // 거리 (km)
            }

            // 미용실 카드 렌더링
            // 편의사항 매핑 테이블
