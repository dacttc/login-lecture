        // 소식 데이터 배열
        function updateRatingContainer(reviews) {
            const reviewCount = reviews.length;
            let totalRating = 0;
            const starCounts = [0, 0, 0, 0, 0]; // 별점 카운트 (1~5)

            // 리뷰 데이터 분석
            reviews.forEach(review => {
                const rating = review.rating || 0; // 별점
                totalRating += rating;
                if (rating >= 1 && rating <= 5) {
                    starCounts[rating - 1]++;
                }
            });

            // 평균 별점 계산
            const averageRating = reviewCount > 0 ? (totalRating / reviewCount).toFixed(1) : 0;

            // 평균 별점 업데이트
            document.querySelector(".average-rating .score").textContent = averageRating;

            // 별 개수 업데이트
            const starsContainer = document.querySelector(".average-rating .stars");
            starsContainer.innerHTML = ""; // 기존 별 제거
            for (let i = 0; i < 5; i++) {
                if (i < Math.floor(averageRating)) {
                    starsContainer.innerHTML += `<span>★</span>`;
                } else if (i < Math.ceil(averageRating)) {
                    starsContainer.innerHTML += `<span>☆</span>`;
                } else {
                    starsContainer.innerHTML += `<span>☆</span>`;
                }
            }

            // 리뷰 개수 업데이트
            document.getElementById("review-count").textContent = `리뷰 ${reviewCount}개`;

            // 막대그래프 업데이트
            const graphSection = document.querySelector(".graph-section");
            const totalVotes = starCounts.reduce((sum, count) => sum + count, 0); // 총 투표 수

            // 각 별점에 대해 진행률 업데이트
            graphSection.innerHTML = ""; // 기존 막대 그래프 초기화
            for (let i = 5; i >= 1; i--) {
                const starCount = starCounts[i - 1];
                const percentage = totalVotes > 0 ? (starCount / totalVotes) * 100 : 0;

                graphSection.innerHTML += `
            <div class="star-bar">
                <div class="label">${i}</div>
                <div class="progress">
                    <div class="fill" style="width: ${percentage}%;"></div>
                </div>
                <div class="votes">${starCount}</div>
            </div>
        `;
            }
        }

        function renderNews() {
            const newsListDiv = document.getElementById('news-list');
            newsListDiv.innerHTML = ''; // 기존 내용 초기화

            news.forEach(item => {
                // 뉴스 카드 컨테이너 생성
                const cardDiv = document.createElement('div');
                cardDiv.classList.add('news-card');
                cardDiv.setAttribute('data-news-id', item.id);

                // 이미지 추가
                const img = document.createElement('img');
                img.src = item.image || '/uploads/default-news.jpg';
                cardDiv.appendChild(img);

                // 제목 추가
                const titleDiv = document.createElement('div');
                titleDiv.classList.add('news-title');
                titleDiv.textContent = item.title;
                cardDiv.appendChild(titleDiv);

                // 날짜 추가
                const dateDiv = document.createElement('div');
                dateDiv.classList.add('news-date');
                dateDiv.textContent = `날짜: ${item.date}`;
                cardDiv.appendChild(dateDiv);

                // 내용 추가
                const contentDiv = document.createElement('div');
                contentDiv.classList.add('news-content');
                contentDiv.textContent = item.content;
                cardDiv.appendChild(contentDiv);

                // 관리자일 경우 수정 및 삭제 버튼 추가
                if (admin) {
                    const adminButtonsDiv = document.createElement('div');
                    adminButtonsDiv.classList.add('admin-buttons');

                    const editButton = document.createElement('button');
                    editButton.textContent = '수정';
                    editButton.addEventListener('click', () => {
                        scrollToTop();
                        openNewsForm('edit', item.id);
                    });

                    const deleteButton = document.createElement('button');
                    deleteButton.textContent = '삭제';
                    deleteButton.addEventListener('click', () => {
                        deleteNews(item.id);
                    });

                    adminButtonsDiv.appendChild(editButton);
                    adminButtonsDiv.appendChild(deleteButton);

                    cardDiv.appendChild(adminButtonsDiv);
                }

                // DOM에 카드 추가
                newsListDiv.appendChild(cardDiv);
            });
        }
