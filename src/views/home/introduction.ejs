                blind_assistance: { icon: "fas fa-blind", label: "시각 장애인 안내 서비스" },
                deaf_support: { icon: "fas fa-deaf", label: "청각 장애인 수화 지원" },
                quiet_service_space: { icon: "fas fa-volume-mute", label: "조용한 서비스 공간 제공" },
                dementia_care: { icon: "fas fa-hands-helping", label: "치매 고객을 위한 특별 케어" },
                intellectual_disability_support: { icon: "fas fa-users-cog", label: "인지 장애인을 위한 간편 설명" },
                safety_restraint_chairs: { icon: "fas fa-shield-alt", label: "안전 구속 기능이 있는 의자" },
                emergency_medical_system: { icon: "fas fa-ambulance", label: "응급 의료 호출 시스템" },
            };

            // 카드 렌더링
            salons.forEach((salon) => {
                // 거리 계산
                const distance = calculateDistance(
                    centerLat,
                    centerLng,
                    salon.latitude,
                    salon.longitude
                );

                const salonElement = document.createElement("div");
                salonElement.classList.add("salon");

                // 편의사항 HTML 생성
                const facilitiesHTML = salon.facilities
                    .map((facility) => {
                        const detail = facilityDetails[facility];
                        if (detail) {
                            return `
                    <div class="facility">
                        <i class="${detail.icon}"></i>
                        <span>${detail.label}</span>
                    </div>
                `;
                        }
                        return "";
                    })
                    .join("");

                salonElement.innerHTML = `
        <div class="image-container">
            <img src="${salon.image}" alt="미용실 이미지">
        </div>
        <h3>${salon.name}</h3>
        <div class="ratings">
            <span>${salon.rating}</span>
        </div>
        <p>${salon.location} ${distance.toFixed(2)} km</p>
     
        <div class="facilities">
            <h4>편의사항:</h4>
            <div class="facility-list">${facilitiesHTML}</div>
        </div>
    `;

