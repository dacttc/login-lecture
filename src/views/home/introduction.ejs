            // 오늘 날짜 가져오기
            const today = new Date();
            today.setHours(0, 0, 0, 0); // 시간 비교를 제거

            // 데이터 배열을 순회하며 요소를 추가
            reservationss.forEach((reservation) => {
                const item = document.createElement("div");
                item.className = "custom-reservation-item";

                // 상태별 클래스 설정
                const statusClass =
                    reservation.status === "대기"
                        ? "custom-status-waiting"
                        : "custom-status-complete";

                // HTML 구성
                item.innerHTML = `
            <h3>${reservation.name}</h3>
            <p>예약 일자: ${reservation.date}</p>
            <div class="custom-status ${statusClass}">${reservation.status}</div>
        `;

