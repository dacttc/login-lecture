        let distanceOp = 1;
        let sortOp = "distance ASC";
        function sort() {





            // 정렬 로직 추가
            let center = map.getCenter();
            reqs = {
                query: `

                SELECT 
                    users.*, 
                    (6371 * acos(cos(radians(${center.getLat()})) 
                        * cos(radians(users.latitude)) 
                        * cos(radians(users.longitude) - radians(${center.getLng()})) 
                        + sin(radians(${center.getLat()})) 
                        * sin(radians(users.latitude)))) AS distance,
                    COUNT(review.store_id) AS review_count
                FROM 
                    users
                LEFT JOIN 
                    review
                ON 
                    users.id = review.store_id
                WHERE 
                    users.shop = 1 -- BOOLEAN true 대신 1로 변경
                GROUP BY 
                    users.id
                HAVING 
                    distance IS NOT NULL AND distance <= ${distanceOp}  
                ORDER BY 
                    distance ASC; -- ${sortOp}를 거리 정렬로 기본값 설정
                        
                        `,
                query_input: [],
                requestid: 5,
            };
            fetch('ServiceRequest', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                credentials: 'include',
                body: JSON.stringify(reqs),
            })
                .then(response => response.json())
                .then(result => {


                    salons = [];
