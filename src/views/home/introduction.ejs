                const reservationDate = new Date(reservation.date);
                reservationDate.setHours(0, 0, 0, 0); // 시간 비교를 제거

                if (reservationDate >= today) {
                    // 오늘 이후 또는 오늘
                    item.innerHTML += `
                <button class="custom-button modify">변경</button>
                <button class="custom-button cancel">취소</button>
            `;
                    checkContainer.appendChild(item); // 아래쪽
