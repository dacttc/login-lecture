        // 시간 슬롯 생성 함수
        function createTimeSlots(dateStr) {
            const timeSlotsContainer = document.getElementById('time-slots-container');
            const timeSlotsElement = document.getElementById('time-slots');
            const selectedDateElement = document.getElementById('selected-date');

            // 시술이 선택되지 않은 경우 경고
            if (!selectedService) {
                alert('시술을 먼저 선택해 주세요.');
                return;
            }

            // 선택한 날짜 표시
            selectedDateElement.textContent = `${dateStr} 예약 가능한 시간`;

            // 기존 시간 슬롯 초기화
            timeSlotsElement.innerHTML = '';

            const reservedTimes = reservations[dateStr] || []; // 예약된 시간 가져오기

            const startTime = 11 * 60; // 오전 11:00을 분으로 환산
            const endTime = 19 * 60 + 30; // 오후 7:30을 분으로 환산
            const slotDuration = 30; // 시간 슬롯의 간격 (30분)
            const needTimeSlots = selectedService.needtime / slotDuration; // 시술에 필요한 슬롯 수

            for (let time = startTime; time <= endTime; time += slotDuration) {
                const hours = Math.floor(time / 60);
                const minutes = time % 60;
                const timeLabel = `${hours}:${minutes === 0 ? '00' : minutes}`;

                const timeSlotButton = document.createElement('button');
                timeSlotButton.className = 'time-slot';
                timeSlotButton.textContent = timeLabel;

                // 현재 슬롯과 다음 슬롯이 비어있는지 확인 (1시간 짜리 시술일 경우 두 개의 슬롯이 필요함)
                let isAvailable = true;
                for (let i = 0; i < needTimeSlots; i++) {
                    const nextSlotTime = time + i * slotDuration;
                    const nextHours = Math.floor(nextSlotTime / 60);
                    const nextMinutes = nextSlotTime % 60;
                    const nextTimeLabel = `${nextHours}:${nextMinutes === 0 ? '00' : nextMinutes}`;

                    if (reservedTimes.includes(nextTimeLabel) || nextSlotTime > endTime) {
                        isAvailable = false; // 예약된 시간이 있다면 선택 불가
                        break;
                    }
                }

                if (!isAvailable) {
                    timeSlotButton.classList.add('disabled');
                    timeSlotButton.disabled = true;
                }

                // 시간 슬롯 클릭 이벤트
                timeSlotButton.addEventListener('click', function () {
                    // 기존 선택된 시간 슬롯 해제
                    const selectedSlot = document.querySelector('.time-slot.selected');
                    if (selectedSlot) {
                        selectedSlot.classList.remove('selected');
                    }
                    // 선택된 슬롯 표시
                    this.classList.add('selected');
                    selectedTime = this.textContent;
