                    SPRITE_MARKER_URL = 'https://t1.daumcdn.net/localimg/localimages/07/mapapidoc/markers_sprites2.png', // 스프라이트 마커 이미지 URL
                    SPRITE_WIDTH = 126, // 스프라이트 이미지 너비
