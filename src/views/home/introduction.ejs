        // 소식 삭제 함수
        function deleteNews(newsId) {

            const reqs = {
                query: `
                   DELETE FROM News  WHERE id = ${newsId};

                `,
                query_input: [],
                username: id,
                requestid: 55,
            };

            fetch('serviceadd', { // 특정 서비스의 위도/경도 가져오기
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                credentials: 'include',
                body: JSON.stringify(reqs),
            })
                .then(response => response.json())
                .then(result => {
                    const index = news.findIndex(n => n.id === newsId);
                    if (index !== -1) {
                        news.splice(index, 1);
                        renderNews();
                    }
                    alert("소식 삭제 완료.");

                })
                .catch(error => {
                    alert('에러 발생:', error);
                });

            console.log('서버 응답:', result);

        }
