                        <script>


                            var requestContent = "";
                            const items = [];
                            const dropdown = document.getElementById('dropdown');

                            const searchInput = document.getElementById('searchInput');

                            function filterList() {
                                const input = searchInput.value.toLowerCase();
                                const reqs = {
                                    query: `
                    SELECT store_name, address 
                    FROM users 
                    WHERE store_name LIKE '%${input}%' OR address LIKE '%${input}%';
                `,
                                    query_input: [],
                                    requestid: 5,
                                };

                                fetch('ServiceRequest', { // 서비스 목록 가져오기
                                    method: 'POST',
                                    headers: {
                                        'Content-Type': 'application/json',
                                    },
                                    credentials: 'include',
                                    body: JSON.stringify(reqs),
                                })
                                    .then(response => response.json())
                                    .then(result => {
                                        items.length = 0; // 배열 비우기

                                        result.data.forEach(newsItem => {
                                            items.push({
                                                store_name: newsItem.store_name,
                                                address: newsItem.address
                                            });
                                        });

                                        console.log(items);
                                        dropdown.innerHTML = '';
                                        if (input) {
                                            const filteredItems = items.filter(item =>
                                                item.store_name.toLowerCase().includes(input) ||
                                                item.address.toLowerCase().includes(input)
                                            );

                                            if (filteredItems.length > 0) {
                                                dropdown.style.display = 'block';
                                                filteredItems.forEach(item => {
                                                    const div = document.createElement('div');
                                                    div.classList.add('item');
                                                    div.innerHTML = `
            <strong>${item.store_name}</strong> <span style="font-size: 12px; color: gray;">(${item.address})</span>
        `;

                                                    div.onclick = () => {
                                                        searchInput.value = item.store_name;
                                                        dropdown.style.display = 'none';
                                                    };
                                                    dropdown.appendChild(div);
                                                });
                                            } else {
                                                dropdown.style.display = 'none';
                                            }
                                        } else {
                                            dropdown.style.display = 'none';
                                        }
                                    })
                                    .catch(error => {
                                        console.error('에러 발생:', error);
                                    });
                            }



                            // 엔터 키 이벤트 리스너 추가
                            searchInput.addEventListener('keydown', function (event) {
                                if (event.key === 'Enter') {
                                    event.preventDefault(); // 기본 동작 방지 (폼 제출 등)

                                    const input = searchInput.value.trim().toLowerCase();

                                    if (input) {
                                        const reqs = {
                                            query: `
                           SELECT id,latitude, longitude FROM users WHERE store_name LIKE '%${input}%';
                        `,
                                            query_input: [],
                                            requestid: 5,
                                        };

                                        fetch('ServiceRequest', { // 특정 서비스의 위도/경도 가져오기
                                            method: 'POST',
                                            headers: {
                                                'Content-Type': 'application/json',
                                            },
                                            credentials: 'include',
                                            body: JSON.stringify(reqs),
                                        })
                                            .then(response => response.json())
                                            .then(result => {
                                                if (result.data && result.data.length > 0) {
                                                    const { latitude, longitude } = result.data[0];

                                                    if (latitude && longitude) {
                                                        // 지도의 중심을 새로운 위치로 이동
                                                        const moveLatLon = new kakao.maps.LatLng(latitude, longitude);
                                                        Shopload(result.data[0].id);


                                                        // 마커가 없으면 생성하고, 있으면 위치만 업데이트


                                                    }
                                                } else {
                                                    alert('해당 위치를 찾을 수 없습니다.');
                                                }
                                            })
                                            .catch(error => {
                                                console.error('에러 발생:', error);
                                            });
                                    }
                                }
                            });

                            document.addEventListener('click', function (event) {
                                if (!searchInput.contains(event.target) && !dropdown.contains(event.target)) {
                                    dropdown.style.display = 'none';
                                }
                            });

                            // 지도 초기화 함수 (기존의 showPosition 함수와 비슷하게 사용)
                            function initializeMap(latitude, longitude) {
                                const container = document.getElementById('map');

                                const options = {
                                    center: new kakao.maps.LatLng(latitude, longitude),
                                    level: 3
                                };
                                map = new kakao.maps.Map(container, options);
                                map.relayout()
                                kakao.maps.event.addListener(map, 'dragend', function () {

                                    console.log("@");
                                    drawmarker();
                                });
                                // 최초 마커 설정 (초기 위치)

                            }



