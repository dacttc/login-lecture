<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" />
    <script src="/js/home/login.js" defer></script>
    <link rel="stylesheet" href="./css/home/login.css">
</head>
<body>
    <!-- 배경 비디오 추가 -->
    <video autoplay muted loop id="background-video">
        <source src="/uploads/KakaoTalk_20241028_174222150.mp4" type="video/mp4">
        Your browser does not support the video tag.
    </video>

    <div class="login-page">
        <div class="form">
            <form class="login-form">
                <h2>로그인</h2>
                <div class="input-group">
                    <i class="fas fa-user"></i>
                    <input type="text" id="id" placeholder="아이디"/>
                </div>
                <div class="input-group">
                    <i class="fas fa-lock"></i>
                    <input type="password" id="psword" placeholder="비밀번호"/>
                </div>
                <button id="button">로그인</button>
                <img src="/uploads/kakao_login_medium_wide.png" alt="카카오톡으로 로그인" class="kakao-login-img" onclick="kakaoLogin()"/>
            </form>
        </div>
    </div>

    <script>
        const kakaoMapKey = "<%= kakaoMapKey %>";
        const redirectUris="<%= redirectUri %>";
        function kakaoLogin() {
            const redirectUri = encodeURIComponent(redirectUris);
            const kakaoUrl = `https://kauth.kakao.com/oauth/authorize?response_type=code&client_id=${kakaoMapKey}&redirect_uri=${redirectUri}`;
            window.location.href = kakaoUrl;
        }
    </script>

    <style>
        /* 배경 비디오 스타일 */
        #background-video {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            object-fit: cover;
            z-index: -1;
        }

        /* 로그인 폼 스타일 */
        .login-page {
            position: relative;
            z-index: 1;
        }

        .kakao-login-img {
            margin-top: 10px;
            width: 100%;
            max-width: 250px;
            cursor: pointer;
        }
    </style>
</body>
</html>
