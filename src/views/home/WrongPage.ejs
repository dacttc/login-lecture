<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>잘못된 URL 경고</title>
    <script>
        function goBackWithAlert() {
            alert("존재하지 않는 페이지입니다.");
            window.history.back();
        }
    </script>
</head>
<body onload="goBackWithAlert()">
    <h1>잘못된 URL입니다</h1>
</body>
</html>
